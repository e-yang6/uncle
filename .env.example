# Copy to .env and fill in. Never commit .env.
PORT=3000

# Team key for uploading scanned GLB files at /heads.html (reads work without it)
HEAD_LIBRARY_TOKEN=
# Same worker key on the app server and Isaac's prepared Mac (separate from upload key)
HEAD_WORKER_TOKEN=
# Used only on the head-building Mac; no incoming port is needed
HEAD_SERVER_URL=https://uncle.health

# Voice (Person 2)
ELEVENLABS_API_KEY=
# Optional: which ElevenLabs voice to use before we have a clone (default: Will)
# ELEVENLABS_VOICE_ID=

# Interview extraction and fallback model (Person 1)
GEMINI_API_KEY=

# Fine-tuned model server on the Vultr GPU (Person 1), e.g. http://GPU_IP:8000/v1
MODEL_URL=

# Face aging service on the Vultr GPU (Person 3), if run as a separate service
AGING_URL=

# Commitment vault, only if built (Solana devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
VAULT_PROGRAM_ID=
